@model EnsoPsikoloji.Models.Hasta

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4>Yeni Hasta Kaydı Oluştur</h4>
                </div>
                <div class="card-body">
                    <!-- Hataları ekranda görmek için bu satırı ekledik -->
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <form asp-action="Create" method="post">
                        <input type="hidden" name="talepId" value="@ViewBag.TalepId" />
                        <div class="mb-3">
                            <label class="form-label">Adı</label>
                            <!-- Ad -> Adi olarak güncellendi -->
                            <input asp-for="Adi" class="form-control" placeholder="Hastanın adını giriniz..." required />
                            <span asp-validation-for="Adi" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Soyadı</label>
                            <!-- Soyad -> Soyadi olarak güncellendi -->
                            <input asp-for="Soyadi" class="form-control" placeholder="Hastanın soyadını giriniz..." required />
                            <span asp-validation-for="Soyadi" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Telefon Numarası</label>
                            <input asp-for="Telefon" class="form-control" placeholder="05XX XXX XX XX" />
                            <span asp-validation-for="Telefon" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">E-posta</label>
                            <input asp-for="Email" class="form-control" placeholder="ornek@mail.com" />
                        </div>
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">Listeye Geri Dön</a>
                            <button type="submit" class="btn btn-success">Kaydı Tamamla</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>