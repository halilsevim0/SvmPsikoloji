@model IEnumerable<EnsoPsikoloji.Models.Hasta>

@{
    ViewData["Title"] = "Danışan (Hasta) Listesi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Kayıtlı Danışanlar</h2>
        <p class="text-muted mb-0">Klinikte kayıtlı tüm hastalar ve dosya geçmişleri.</p>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Sekreter"))
    {
        <a asp-action="Create" class="btn btn-primary fw-bold">
            + Yeni Danışan Ekle
        </a>
    }
</div>

<!-- Arama Formu -->
<form asp-action="Index" method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="arananKelime" class="form-control" placeholder="Danışan adı veya soyadına göre ara..." />
        <button class="btn btn-outline-secondary" type="submit">🔍 Ara</button>
    </div>
</form>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Adı Soyadı</th>
                    <th>Telefon</th>
                    <th>Kayıt Tarihi</th>
                    <th class="text-end pe-3">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">Kayıtlı danışan bulunamadı.</td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-3 fw-bold text-dark">
                            @item.Adi @item.Soyadi
                        </td>
                        <td>@(string.IsNullOrEmpty(item.Telefon) ? "-" : item.Telefon)</td>
                        <td class="text-muted small">@item.KayitTarihi.ToString("dd.MM.yyyy")</td>
                        <td class="text-end pe-3">
                            <div class="btn-group">
                                <!-- İşte Seans Notları ve Detay Sayfasına Giden Buton -->
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white fw-bold">
                                    📋 Detay & Notlar
                                </a>

                                @if (User.IsInRole("Admin") || User.IsInRole("Sekreter"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                        Düzenle
                                    </a>
                                }

                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                        Sil
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>