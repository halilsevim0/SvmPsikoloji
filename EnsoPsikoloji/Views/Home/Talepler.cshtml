@model IEnumerable<EnsoPsikoloji.Models.IletisimTalep>

@{
    ViewData["Title"] = "Gelen Danışan Talepleri";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Gelen İletişim Talepleri</h2>
        <p class="text-muted mb-0">Web sitesinden bilgi ve randevu talebi bırakan danışanlar.</p>
    </div>
    <span class="badge bg-danger fs-6 px-3 py-2">
        Bekleyen: @Model.Count(t => !t.ArandiMi)
    </span>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Tarih</th>
                    <th>Ad Soyad</th>
                    <th>Telefon</th>
                    <th>İlgilendiği Konu / Uzman</th>
                    <th>Durum</th>
                    <th class="text-end pe-3">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">Henüz gelen bir iletişim talebi bulunmuyor.</td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr class="@(item.ArandiMi ? "opacity-75 bg-light" : "")">
                        <td class="ps-3 text-muted small">@item.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="fw-bold text-dark">@item.AdSoyad</td>
                        <td>
                            <a href="tel:@item.Telefon" class="btn btn-sm btn-outline-secondary">
                                📞 @item.Telefon
                            </a>
                        </td>
                        <td><span class="badge bg-light text-dark border">@item.TalepDetayi</span></td>
                        <td>
                            @if (item.ArandiMi)
                            {
                                <span class="badge bg-success-subtle text-success border border-success">✓ Arandı / Tamamlandı</span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-dark border border-warning">⏳ Görüşme Bekliyor</span>
                            }
                        </td>
                        <td class="text-end pe-3">
                            <div class="btn-group">
                                @* 1. Randevuya Dönüştür Butonu *@
                                <a asp-controller="Hastalar" 
                                   asp-action="Create" 
                                   asp-route-adSoyad="@item.AdSoyad" 
                                   asp-route-telefon="@item.Telefon" 
                                   asp-route-talepId="@item.Id" 
                                   class="btn btn-sm btn-primary">
                                    🗓️ Randevuya Dönüştür
                                </a>

                                @* 2. Sadece Arandı Olarak İşaretle *@
                                @if (!item.ArandiMi)
                                {
                                    <form asp-action="TalepTamamla" asp-route-id="@item.Id" method="post" class="d-inline ms-1">
                                        <button type="submit" class="btn btn-sm btn-outline-success" title="Sadece arandı olarak işaretle">
                                            ✓
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
