@{
    ViewData["Title"] = "Randevu Takvimi";
}

<!-- FullCalendar CSS ve JS CDN Bağlantıları -->
<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="text-primary fw-bold mb-0">Haftalık ve Aylık Seans Takvimi</h2>
            <p class="text-muted">Seansları takvim üzerinde görüntüleyebilir, detayına gitmek için seansa tıklayabilirsiniz.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Tablo Görünümüne Dön</a>
            <a asp-action="Create" class="btn btn-primary">+ Yeni Randevu</a>
        </div>
    </div>

    <!-- Takvim Kutusu -->
    <div class="card shadow p-4">
        <div id="calendar"></div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var calendarEl = document.getElementById('calendar');

        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'timeGridWeek', // Varsayılan olarak haftalık saatli görünümle açılsın
            locale: 'tr', // Türkçe dil desteği
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,timeGridDay'
            },
            buttonText: {
                today: 'Bugün',
                month: 'Ay',
                week: 'Hafta',
                day: 'Gün'
            },
            slotMinTime: '08:00:00', // Mesai başlangıcı
            slotMaxTime: '21:00:00', // Mesai bitişi
            allDaySlot: false,
            events: '/Randevular/GetRandevularJson', // 1. adımda yazdığımız JSON endpoint
            eventClick: function(info) {
                if (info.event.url) {
                    info.jsEvent.preventDefault();
                    window.location.href = info.event.url; // Tıklanan randevunun düzenleme ekranına yönlendir
                }
            }
        });

        calendar.render();
    });
</script>