@model IEnumerable<EnsoPsikoloji.Models.Randevu>
@{
    ViewData["Title"] = "Randevu Listesi";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-calendar2-check me-2"></i>Randevu Yönetimi
            </h2>
            <p class="text-muted mb-0">Tüm klinik seanslarını takip edebilir, bildirim gönderebilir ve filtreleyebilirsiniz.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Takvim" class="btn btn-outline-info">
                <i class="bi bi-calendar3 me-1"></i>Takvim Görünümü
            </a>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Yeni Randevu Oluştur
            </a>
        </div>
    </div>

    @if (TempData["BasariMesaji"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["BasariMesaji"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["HataMesaji"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["HataMesaji"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Arama ve Filtreleme Formu -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" name="arananKelime" class="form-control" placeholder="Danışan veya Psikolog adına göre ara..." value="@Context.Request.Query["arananKelime"]" />
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-secondary w-100">Filtrele</button>
                </div>
                @if (!string.IsNullOrEmpty(Context.Request.Query["arananKelime"]))
                {
                    <div class="col-md-2">
                        <a asp-action="Index" class="btn btn-outline-danger w-100">Temizle</a>
                    </div>
                }
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Danışan</th>
                            <th>Uzman Psikolog</th>
                            <th>Tarih ve Saat</th>
                            <th>Ücret / Ödeme</th>
                            <th>Durum</th>
                            <th>Bildirim</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@(item.Hasta?.Adi) @(item.Hasta?.Soyadi)</div>
                                    <small class="text-muted">@(item.Hasta?.Telefon ?? item.Hasta?.Email ?? "-")</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(item.Psikolog?.AdSoyad ?? "Atanmadı")
                                    </span>
                                </td>
                                <td>
                                    <strong>@item.RandevuTarihi.ToString("dd.MM.yyyy")</strong>
                                    <span class="text-muted small ms-1">@item.RandevuTarihi.ToString("HH:mm")</span>
                                </td>
                                <td>
                                    <strong>@(item.Ucret.HasValue ? item.Ucret.Value.ToString("C2") : "₺0,00")</strong>
                                    <br />
                                    @if (item.OdemeDurumu == "Ödendi")
                                    {
                                        <span class="badge bg-success">Ödendi</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Bekliyor</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Durum == "Aktif")
                                    {
                                        <span class="badge bg-primary">Aktif</span>
                                    }
                                    else if (item.Durum == "Tamamlandı")
                                    {
                                        <span class="badge bg-success">Tamamlandı</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@item.Durum</span>
                                    }
                                </td>
                                <td>
                                    <form asp-action="Hatirlat" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-info" title="Danışana SMS ve E-posta hatırlatması gönder">
                                            <i class="bi bi-bell-fill me-1"></i>Hatırlat
                                        </button>
                                    </form>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Detay</a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Sil</a>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">Kriterlere uygun randevu kaydı bulunamadı.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
</div>