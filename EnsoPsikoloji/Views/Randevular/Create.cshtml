@model EnsoPsikoloji.Models.Randevu

@{
    ViewData["Title"] = "Yeni Randevu Oluştur";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Yeni Randevu Oluştur</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="form-group mb-3">
                            <label asp-for="HastaId" class="control-label fw-bold">Hasta Seçin</label>
                            <select asp-for="HastaId" class="form-select" asp-items="ViewBag.HastaId">
                                <option value="">-- Hasta Seçiniz --</option>
                            </select>
                            <span asp-validation-for="HastaId" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="PsikologId" class="control-label fw-bold">Psikolog Seçin</label>
                            <select asp-for="PsikologId" class="form-select" asp-items="ViewBag.PsikologId">
                                <option value="">-- Psikolog Seçiniz --</option>
                            </select>
                            <span asp-validation-for="PsikologId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RandevuTarihi" class="form-label fw-bold">Randevu Tarihi ve Saati</label>
                            <input asp-for="RandevuTarihi" type="datetime-local" class="form-control" required />
                            <span asp-validation-for="RandevuTarihi" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notlar" class="form-label fw-bold">Seans Notları</label>
                            <textarea asp-for="Notlar" class="form-control" rows="3" placeholder="Ön not ekleyebilirsiniz..."></textarea>
                            <span asp-validation-for="Notlar" class="text-danger"></span>
                        </div>

                        <!-- 1.3 Adımında Bahsettiğimiz Ücret ve Ödeme Alanları -->
                        <div class="mb-3">
                            <label asp-for="Ucret" class="form-label fw-bold">Seans Ücreti (₺)</label>
                            <input asp-for="Ucret" type="number" step="50" class="form-control" placeholder="Örn: 1500" />
                            <span asp-validation-for="Ucret" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="OdemeDurumu" class="form-label fw-bold">Ödeme Durumu</label>
                            <select asp-for="OdemeDurumu" class="form-select">
                                <option value="Bekliyor">Ödeme Bekliyor</option>
                                <option value="Odendi">Ödendi</option>
                            </select>
                            <span asp-validation-for="OdemeDurumu" class="text-danger"></span>
                        </div>

                        <!-- Butonlar -->
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">Listeye Geri Dön</a>
                            <button type="submit" class="btn btn-danger">Randevuyu Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>