@model EnsoPsikoloji.Models.Psikolog

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4>Yeni Psikolog Kaydı</h4>
                </div>
                <div class="card-body">
                    <!-- Hataları üst kısımda net görmek için buraya aldık -->
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <form asp-action="Create" method="post">
                        <div class="mb-3">
                            <label class="form-label">Adı</label>
                            <input asp-for="Ad" class="form-control" placeholder="Uzmanın adını giriniz..." required />
                            <span asp-validation-for="Ad" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Soyadı</label>
                            <input asp-for="Soyad" class="form-control" placeholder="Uzmanın soyadını giriniz..." required />
                            <span asp-validation-for="Soyad" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Uzmanlık Alanı</label>
                            <input asp-for="UzmanlikAlan" class="form-control" placeholder="Örn: Klinik Psikolog, Aile Terapisti" />
                            <span asp-validation-for="UzmanlikAlan" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Telefon Numarası</label>
                            <input asp-for="Telefon" class="form-control" placeholder="05XX XXX XX XX" />
                            <span asp-validation-for="Telefon" class="text-danger"></span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">Listeye Geri Dön</a>
                            <button type="submit" class="btn btn-success">Kaydı Tamamla</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>