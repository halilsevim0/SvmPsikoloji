<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Enso Psikoloji</title>
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Enso Zen & Health Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Üst Duyuru / İletişim Bandı (Sadece ziyaretçiye) -->
    <div class="bg-dark text-white-50 py-1 px-3 d-none d-md-block small" style="background-color: #1E3D2D !important;">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex gap-3">
                <span><i class="bi bi-geo-alt me-1 text-warning"></i>Bağdat Caddesi No: 142, Kadıköy / İstanbul</span>
                <span><i class="bi bi-clock me-1 text-warning"></i>Pzt - Cts: 09:00 - 20:00</span>
            </div>
            <div>
                <a href="tel:02160000000" class="text-white text-decoration-none fw-semibold">
                    <i class="bi bi-telephone-fill me-1 text-warning"></i>(0216) 450 00 00
                </a>
            </div>
        </div>
    </div>

    <!-- Ana Navigasyon -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg enso-navbar py-3">
            <div class="container">
                <a class="navbar-brand enso-logo" asp-controller="Home" asp-action="Index">
                    <span class="enso-circle-icon"></span>
                    <span>ENSO <span style="font-weight: 300; opacity: 0.85;">PSİKOLOJİ</span></span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#ensoNavbar" aria-controls="ensoNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-2 text-dark"></i>
                </button>

                <div class="collapse navbar-collapse" id="ensoNavbar">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/#hizmetler">Hizmetlerimiz</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/#uzmanlarimiz">Uzman Kadromuz</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/#hakkimizda">Hakkımızda</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/#iletisim">İletişim</a>
                        </li>

                        @* Klinik Personeli Yetki Menüsü *@
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin") || User.IsInRole("Sekreter") || User.IsInRole("Psikolog"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-primary fw-bold" href="#" id="klinikDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-hospital me-1"></i>Klinik İşlemleri
                                    </a>
                                    <ul class="dropdown-menu shadow-sm border-0 rounded-3" aria-labelledby="klinikDropdown">
                                        <li><a class="dropdown-item py-2" asp-controller="Hastalar" asp-action="Index"><i class="bi bi-people me-2 text-success"></i>Danışanlar</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Randevular" asp-action="Index"><i class="bi bi-calendar2-check me-2 text-primary"></i>Randevular</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Randevular" asp-action="Takvim"><i class="bi bi-calendar-week me-2 text-info"></i>Haftalık Takvim</a></li>
                                    </ul>
                                </li>
                            }

                            @if (User.IsInRole("Admin") || User.IsInRole("Sekreter"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-warning fw-semibold" asp-controller="Home" asp-action="Talepler">
                                        <i class="bi bi-bell-fill me-1"></i>Gelen Talepler
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-danger fw-bold" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-shield-check me-1"></i>Yönetim
                                    </a>
                                    <ul class="dropdown-menu shadow-sm border-0 rounded-3" aria-labelledby="adminDropdown">
                                        <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-2 text-danger"></i>Klinik Dashboard</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Finans"><i class="bi bi-cash-stack me-2 text-success"></i>Finans & Hakediş Raporu</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Kullanicilar" asp-action="Index"><i class="bi bi-person-lines-fill me-2 text-secondary"></i>Personel Yönetimi</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Psikologlar" asp-action="Index"><i class="bi bi-person-badge me-2 text-primary"></i>Psikolog Kadrosu</a></li>
                                    </ul>
                                </li>
                            }
                        }
                    </ul>

                    <!-- Giriş / Kullanıcı Durumu -->
                    <div class="d-flex align-items-center gap-2">
                        <partial name="_LoginPartial" />
                        <a href="/#randevu-al" class="btn btn-enso-primary btn-sm d-none d-lg-inline-flex align-items-center gap-2">
                            <i class="bi bi-calendar-plus"></i>Randevu Al
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Ana İçerik -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Zen & Sağlık Temalı Modern Footer -->
    <footer class="enso-footer">
        <div class="container">
            <div class="row g-4 justify-content-between">
                <!-- Marka & Açıklama -->
                <div class="col-lg-4 col-md-6">
                    <div class="enso-logo text-white mb-3" style="color: #FFFFFF !important;">
                        <span class="enso-circle-icon" style="border-color: #D4A373;"></span>
                        <span>ENSO <span style="font-weight: 300; opacity: 0.85;">PSİKOLOJİ</span></span>
                    </div>
                    <p class="text-white-50 pe-lg-4">
                        Enso Psikolojik Danışmanlık Merkezi; bireylerin, çiftlerin ve ailelerin kendi iç dengelerini bulmalarına bilimsel, etik ve empatik yaklaşımlarla rehberlik eder.
                    </p>
                    <div class="d-flex gap-3 fs-5 mt-3">
                        <a href="#" class="text-white-50"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="text-white-50"><i class="bi bi-linkedin"></i></a>
                        <a href="#" class="text-white-50"><i class="bi bi-youtube"></i></a>
                        <a href="#" class="text-white-50"><i class="bi bi-facebook"></i></a>
                    </div>
                </div>

                <!-- Hızlı Hizmetler -->
                <div class="col-lg-2 col-md-6">
                    <h5 class="mb-3">Terapilerimiz</h5>
                    <ul class="list-unstyled d-flex flex-column gap-2">
                        <li><a href="/#hizmetler">Bireysel Yetişkin Terapisi</a></li>
                        <li><a href="/#hizmetler">Çift & Evlilik Danışmanlığı</a></li>
                        <li><a href="/#hizmetler">EMDR Travma Terapisi</a></li>
                        <li><a href="/#hizmetler">Çocuk & Ergen Psikolojisi</a></li>
                        <li><a href="/#hizmetler">Bilişsel Davranışçı Terapi</a></li>
                        <li><a href="/#hizmetler">Online Psikolojik Destek</a></li>
                    </ul>
                </div>

                <!-- Kurumsal / İlkeler -->
                <div class="col-lg-2 col-md-6">
                    <h5 class="mb-3">Kurumsal</h5>
                    <ul class="list-unstyled d-flex flex-column gap-2">
                        <li><a href="/#hakkimizda">Hakkımızda & Vizyon</a></li>
                        <li><a href="/#uzmanlarimiz">Uzman Psikolog Kadromuz</a></li>
                        <li><a href="/#hakkimizda">Etik & Gizlilik İlkeleri</a></li>
                        <li><a href="/#sss">Sıkça Sorulan Sorular</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">Gizlilik Politikası</a></li>
                    </ul>
                </div>

                <!-- İletişim Bilgileri -->
                <div class="col-lg-3 col-md-6" id="iletisim">
                    <h5 class="mb-3">Klinik İletişim</h5>
                    <ul class="list-unstyled d-flex flex-column gap-2 text-white-50">
                        <li><i class="bi bi-geo-alt text-warning me-2"></i>Bağdat Cad. No: 142 K:3 Suadiye, Kadıköy / İstanbul</li>
                        <li><i class="bi bi-telephone text-warning me-2"></i><a href="tel:02160000000">(0216) 450 00 00</a></li>
                        <li><i class="bi bi-whatsapp text-warning me-2"></i><a href="https://wa.me/905000000000" target="_blank">0555 000 00 00 (WhatsApp)</a></li>
                        <li><i class="bi bi-envelope text-warning me-2"></i><a href="mailto:info@ensopsikoloji.com">info@ensopsikoloji.com</a></li>
                    </ul>
                </div>
            </div>

            <!-- Alt Telif & Bilgi -->
            <div class="footer-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                <p class="mb-0 text-white-50">&copy; @DateTime.Now.Year Enso Psikolojik Danışmanlık Merkezi. Tüm hakları saklıdır.</p>
                <p class="mb-0 text-white-50 small">Bu sitede yer alan içerikler yalnızca bilgilendirme amaçlıdır; tıbbi teşhis ve tedavi yerine geçmez.</p>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
